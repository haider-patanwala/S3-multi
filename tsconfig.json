{
	"compilerOptions": {
		"strict": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		// So a *.check.ts can pull in a module that itself has relative imports:
		// node's ESM resolver needs the explicit extension, tsc needs this flag to
		// tolerate it. Safe here — every build is --noEmit.
		"allowImportingTsExtensions": true,
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	// *.check.ts are standalone node scripts (`node src/lib/cdn.check.ts`), not
	// app code — node type-strips and runs them directly.
	"exclude": ["**/*.check.ts"]
}
